# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Never commit ────────────────────────────────────────────────────────────
# Self-contained server build for the company deployment: a full copy of the
# app plus its node_modules (~110 MB), produced by the standalone build.
/smc-task-management-standalone/

# Database dumps. These contain real client data and, depending on how they
# were produced, connection details — they belong in secure backup storage,
# never in the repository.
*.sql
!prisma/sql/*.sql

# Local scratch/diagnostic output.
/.diag/
/.tmp-work/
