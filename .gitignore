# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real ones NEVER get committed.
# This blanket rule is what keeps .env.local, .env.development.local,
# .env.build and .env.rehearsal out of the repository.
.env*

# …except the two TEMPLATES, which contain only placeholders. Without these
# exceptions a fresh clone arrives with no record of which variables the app
# needs, which is how a deployment ends up missing one.
# Both are checked for real credentials before every commit.
!.env.example
!deployment/.env.company.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Never commit ────────────────────────────────────────────────────────────
# Self-contained server build for the company deployment: a full copy of the
# app plus its node_modules (~110 MB), produced by the standalone build.
/smc-task-management-standalone/

# Database dumps. These contain real client data and, depending on how they
# were produced, connection details — they belong in secure backup storage,
# never in the repository.
*.sql
!prisma/sql/*.sql

# Local scratch/diagnostic output.
/.diag/
/.tmp-work/

# Built deployment package — regenerate with `npm run build:standalone`, never commit
/deployment/app/
