# ─────────────────────────────────────────────────────────────────────────────
# SMC Task Management — company server environment TEMPLATE
#
# Copy this to `.env.build` in the project root and fill in the real values.
# `.env.build` is gitignored and must NEVER be committed or copied into the
# deployment package.
#
#   Copy-Item deployment\.env.company.example .env.build
#
# On the server itself you may prefer to set these in the process environment
# (systemd `Environment=`, pm2 ecosystem file, Windows service) instead of a
# file. Either works — the application only reads process.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# The COMPANY PostgreSQL database, after the pg_restore.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains @ : / ? # or %, percent-encode it.
# Add ?sslmode=require only if your server enforces TLS.
DATABASE_URL=postgresql://smc_app:CHANGE_ME@127.0.0.1:5432/smc_task_management

# Signs the session cookie. MUST be at least 32 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# IMPORTANT: changing this value signs every user out. Keep it stable.
# You may reuse the current production secret so nobody is logged out during
# the switchover — take it from the existing .env.build, do not invent one.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long

# Must be exactly "production". This is what makes session cookies Secure,
# turns off development diagnostics, and disables the /api/dev/* routes.
NODE_ENV=production

# ── SERVER BINDING ───────────────────────────────────────────────────────────

# Port the Node process listens on. The reverse proxy forwards to this.
PORT=3000

# Bind to loopback only: the reverse proxy is the public face, and the app
# should not be reachable directly from the network.
HOSTNAME=127.0.0.1

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# How long a session lasts. Defaults to 7d if unset.
JWT_EXPIRES_IN=7d

# Visit-close summary emails. If RESEND_API_KEY is unset, email is skipped
# silently and nothing else breaks.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_EMAIL=Crita@smc.com

# ─────────────────────────────────────────────────────────────────────────────
# NOT SET HERE — and why
#
# NEXT_PUBLIC_BASE_PATH is a BUILD-TIME variable. It is already compiled into
# the package (see deployment/app/BUILD-INFO.json → basePath). Setting it at
# startup has NO EFFECT. To change the mount point you must rebuild:
#
#   npm run build:standalone -- --base-path /your/new/path
#
# ALLOW_REMOTE_DB is a development escape hatch. It is not needed in
# production and should not be set on the server.
# ─────────────────────────────────────────────────────────────────────────────
