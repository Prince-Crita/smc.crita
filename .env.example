# ─── Database (Required) ──────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled endpoint recommended for Vercel)
# Get from: Neon Console → Project → Connection Details → Connection string
# Use the POOLED connection string for serverless (contains "-pooler" in hostname)
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.region.neon.tech/DBNAME?sslmode=require"

# ─── Authentication (Required) ────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-random-jwt-secret-min-32-chars-here"

# ─── Email — Resend (Optional) ────────────────────────────────────────────────
# Required ONLY for visit close summary emails.
# If not set: emails are skipped silently in production.
# Get from: https://resend.com → API Keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SMC Audit <noreply@yourdomain.com>"
ADMIN_EMAIL="admin@yourdomain.com"

# ─── Notes for Vercel ─────────────────────────────────────────────────────────
# Add ALL variables above in Vercel → Project Settings → Environment Variables
# Do NOT add DATABASE_URL or JWT_SECRET to source control / git
# NODE_ENV is automatically set to "production" by Vercel — do not override

# ─── Mount point / reverse proxy (Optional) ───────────────────────────────────
# LEAVE UNSET for localhost and for the existing Vercel deployment — the app
# then serves from the domain root exactly as it always has:
#   http://localhost:3000/            http://localhost:3000/api/...
#
# Set it ONLY when the app is served from a sub-path behind a reverse proxy.
# It is read at BUILD TIME, so it must be present for `npm run build`, e.g.
#   NEXT_PUBLIC_BASE_PATH=/client-trial/smc-task-management
# The app then serves every page, asset and API under that prefix:
#   https://company-domain/client-trial/smc-task-management/
#   https://company-domain/client-trial/smc-task-management/api/...
# The reverse proxy must forward the request URI UNCHANGED (must NOT strip the
# prefix). Internal route files are unaffected — they remain /api/*, /admin/*.
# NEXT_PUBLIC_BASE_PATH=""
