# ─── Database (Required) ──────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled endpoint recommended for Vercel)
# Get from: Neon Console → Project → Connection Details → Connection string
# Use the POOLED connection string for serverless (contains "-pooler" in hostname)
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.region.neon.tech/DBNAME?sslmode=require"

# ─── Authentication (Required) ────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-random-jwt-secret-min-32-chars-here"

# ─── Email — Resend (Optional) ────────────────────────────────────────────────
# Required ONLY for visit close summary emails.
# If not set: emails are skipped silently in production.
# Get from: https://resend.com → API Keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SMC Audit <noreply@yourdomain.com>"
ADMIN_EMAIL="admin@yourdomain.com"

# ─── Visit photos — AWS S3 (Required to start visits) ─────────────────────────
# Executives must upload a geotagged photo to open a visit; without these the
# Open Visit step reports that photo storage is not configured.
# Server-side only: never prefix with NEXT_PUBLIC_, never commit real values.
# On Vercel set ALL FOUR explicitly — the runtime injects its own unusable
# AWS_* values otherwise.
AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"
AWS_REGION="ap-south-2"
AWS_S3_BUCKET="smc-task-management-media-bucket"

# ─── Notes for Vercel ─────────────────────────────────────────────────────────
# Add ALL variables above in Vercel → Project Settings → Environment Variables
# Do NOT add DATABASE_URL or JWT_SECRET to source control / git
# NODE_ENV is automatically set to "production" by Vercel — do not override

# ─── Mount point / reverse proxy (Optional) ───────────────────────────────────
# Canonical path lives in config/base-path.mjs (APP_BASE_PATH).
# LEAVE UNSET for localhost and Vercel — the app serves from the domain root.
#
# Standalone builds (`npm run build:standalone`) set this automatically from
# APP_BASE_PATH. Override only for a different mount point:
#   NEXT_PUBLIC_BASE_PATH=/some/other/path
#
# The reverse proxy must forward the request URI UNCHANGED (must NOT strip the
# prefix). Internal route files remain /api/*, /admin/*.
# NEXT_PUBLIC_BASE_PATH=""
