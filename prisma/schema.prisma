// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EXECUTIVE
  SUPER_ADMIN
}

enum VisitStatus {
  PENDING
  OPEN
  CLOSED
  CANCELLED
}

// A visit is worked either by one executive (SOLO) or by a team (TEAM).
// Visit.executiveId remains the single source of truth for "who owns this
// visit": the solo executive, or the team LEAD. That keeps every existing
// admin query, reassignment path and the lead-only close check working
// unchanged — team membership is additive, held in VisitAssignment.
enum VisitType {
  SOLO
  TEAM
}

enum VisitRole {
  LEAD
  MEMBER
}

// NOTE: TaskType enum kept for reference only.
// Task.taskType and SubtaskTemplate.taskType fields are now String
// to support custom task types per client beyond these 6 defaults.
enum TaskType {
  OPERATIONAL_VERIFICATION
  STOCK_VERIFICATION
  AVF_REPORT
  ACCOUNTS_VERIFICATION
  MR_MONTHLY_REPORT
  MD_MEETING
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIALLY_COMPLETED
}

enum MdMeetingAnswer {
  YES
  NO
}

enum ActivityAction {
  VISIT_CREATED
  VISIT_OPENED
  VISIT_CLOSED
  TASK_STARTED
  TASK_COMPLETED
  SUBTASK_COMPLETED
  SUBTASK_INCOMPLETE
  CARRY_FORWARD_APPLIED
  SUMMARY_GENERATED
  USER_LOGIN
  USER_LOGOUT
  EXECUTIVE_ADDED
  EXECUTIVE_UPDATED
  EXECUTIVE_DEACTIVATED
  EXECUTIVE_PASSWORD_RESET
  EXECUTIVE_DELETED
  CLIENT_ADDED
  CLIENT_UPDATED
  CLIENT_ARCHIVED
  CLIENT_DELETED
  VISIT_REASSIGNED
  VISIT_REMOVED
  SUBTASK_TEMPLATE_UPDATED
  ADMIN_ADDED
  ADMIN_UPDATED
  ADMIN_DEACTIVATED
  ADMIN_PASSWORD_RESET
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DelegationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedVisits     Visit[]             @relation("ExecutiveVisits")
  assignedClients    Client[]            @relation("ClientAssignedExec")
  activityLogs       ActivityLog[]
  reassignmentsFrom  VisitReassignment[] @relation("ReassignFrom")
  reassignmentsTo    VisitReassignment[] @relation("ReassignTo")
  reassignmentsDone  VisitReassignment[] @relation("ReassignedBy")
  attendance         Attendance[]        @relation("ExecutiveAttendance")
  leaveRequests      LeaveRequest[]      @relation("ExecutiveLeaves")
  leaveReviews       LeaveRequest[]      @relation("AdminLeaveReviews")
  delegationsFrom    VisitDelegation[]   @relation("DelegationFrom")
  delegationsTo      VisitDelegation[]   @relation("DelegationTo")
  teamAssignments    VisitAssignment[]   @relation("VisitTeamAssignments")
  carryForwardApprovals Subtask[]        @relation("CarryForwardApprovals")
  adminOperations    AdminOperation[]    @relation("AdminOperationActor")
  undoneOperations   AdminOperation[]    @relation("AdminOperationUndoer")

  @@map("users")
}

// ─── Super Admin operation log (§1) ──────────────────────────────────────────
// Records administrative mutations with enough before/after state to be
// genuinely reversible. `isReversible` is false for operations that cannot be
// safely restored (e.g. cascade deletes) — those are still logged for the
// activity view, but Undo refuses them rather than corrupting relations.
model AdminOperation {
  id           String    @id @default(cuid())
  userId       String
  action       String    // e.g. "CLIENT_UPDATED", "VISIT_ASSIGNMENT_UPDATED"
  entityType   String    // "Client" | "Visit" | "Subtask" | ...
  entityId     String
  summary      String    // human-readable "what changed"
  reason       String?   // why, when the actor supplied one (Super Admin corrections)
  beforeJson   Json?     // field values prior to the change
  afterJson    Json?     // field values after the change
  isReversible Boolean   @default(false)
  undoneAt     DateTime?
  undoneById   String?
  createdAt    DateTime  @default(now())

  user     User  @relation("AdminOperationActor", fields: [userId], references: [id])
  undoneBy User? @relation("AdminOperationUndoer", fields: [undoneById], references: [id])

  @@index([createdAt])
  @@map("admin_operations")
}

model Attendance {
  id             String    @id @default(cuid())
  executiveId    String
  date           DateTime  // stored as midnight UTC for the day
  punchIn        DateTime
  punchOut       DateTime?
  workingMinutes Int?
  isLate         Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  executive User @relation("ExecutiveAttendance", fields: [executiveId], references: [id])

  @@unique([executiveId, date])
  @@map("attendance")
}

model LeaveRequest {
  id           String      @id @default(cuid())
  executiveId  String
  date         DateTime    // the date leave is requested for
  reason       String
  status       LeaveStatus @default(PENDING)
  adminComment String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  executive  User  @relation("ExecutiveLeaves",     fields: [executiveId],  references: [id])
  reviewedBy User? @relation("AdminLeaveReviews",   fields: [reviewedById], references: [id])

  @@unique([executiveId, date])
  @@map("leave_requests")
}


model Client {
  id             String    @id @default(cuid())
  name           String
  code           String    @unique
  contactPerson  String
  address        String
  phone          String?
  email          String?
  reportEmails   String[]  @default([])
  assignedExecId String?
  seniorExecId   String?
  startDate      DateTime?
  endDate        DateTime?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  visits            Visit[]
  assignedExec      User?              @relation("ClientAssignedExec", fields: [assignedExecId], references: [id])
  subtaskTemplates  SubtaskTemplate[]  @relation("ClientSubtaskTemplates")
  taskTypeConfigs   ClientTaskType[]   @relation("ClientTaskTypes")

  @@map("clients")
}

// ─── Per-client MAIN task-type configuration ───────────────────────────────
// Overrides for the 6 default task types (rename / soft-delete / reorder)
// and registrations of admin-created custom main task types. A row here only
// affects visits created AFTER the change — existing visits keep the tasks
// they were created with, so historical data and carry-forward relationships
// (which match by the stable `taskType` key) are never broken.
model ClientTaskType {
  id         String   @id @default(cuid())
  clientId   String
  taskType   String
  title      String?  // null = keep the default title (renames set this)
  orderIndex Int?     // null = keep the default position
  isDeleted  Boolean  @default(false) // soft-hide a task type for future visits
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client Client @relation("ClientTaskTypes", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, taskType])
  @@map("client_task_types")
}

model Visit {
  id            String      @id @default(cuid())
  visitNumber   String      @unique
  clientId      String
  executiveId   String
  status        VisitStatus @default(PENDING)
  // SOLO (default, matches every pre-existing visit) or TEAM. When TEAM, the
  // executives are listed in `assignments`; `executiveId` is the team LEAD.
  visitType     VisitType   @default(SOLO)
  scheduledDate DateTime
  // End of the visit's working window. Carry-forward is generated ONLY after
  // this date has passed (see processDueCarryForwards). When null, the end
  // of the scheduledDate's IST calendar day is used.
  endDate       DateTime?
  openedAt      DateTime?
  closedAt      DateTime?
  summaryJson   Json?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  client        Client              @relation(fields: [clientId], references: [id])
  executive     User                @relation("ExecutiveVisits", fields: [executiveId], references: [id])
  tasks         Task[]
  activityLogs  ActivityLog[]
  reassignments VisitReassignment[]
  delegations   VisitDelegation[]
  assignments   VisitAssignment[]

  // ─── Indexes ───────────────────────────────────────────────────────────────
  // PostgreSQL does NOT create an index for a foreign key, so every lookup
  // below was a sequential scan of the whole table:
  //   clientId      client detail + visit history, carry-forward grouping
  //   executiveId   the executive's own lists, the admin's per-executive views
  //   scheduledDate the calendar's week window and every date-ordered list
  //   status        the carry-forward due sweep (status IN (OPEN, CLOSED))
  //   updatedAt     the admin dashboard's ordering of every visit
  // Indexes only; no column, type or relation changes — existing rows and
  // queries behave exactly as before, just without the scans.
  @@index([clientId])
  @@index([executiveId])
  @@index([scheduledDate])
  @@index([status])
  @@index([updatedAt])
  @@map("visits")
}

// ─── Team membership for a visit ──────────────────────────────────────────────
// One row per executive working a TEAM visit, including the LEAD (so the team
// can be read from a single place). SOLO visits carry no rows here — their
// executive is Visit.executiveId, exactly as before.
//
// Access rule used across the executive APIs: an executive may open a visit
// when visit.executiveId === them OR a row here matches them. Only the LEAD
// (i.e. visit.executiveId) may close it.
model VisitAssignment {
  id          String    @id @default(cuid())
  visitId     String
  executiveId String
  role        VisitRole @default(MEMBER)
  createdAt   DateTime  @default(now())

  visit     Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  executive User  @relation("VisitTeamAssignments", fields: [executiveId], references: [id])

  // An executive appears at most once per visit — the DB-level guard behind
  // the "prevent the same executive from being selected twice" rule.
  @@unique([visitId, executiveId])
  @@map("visit_assignments")
}

model Task {
  id              String           @id @default(cuid())
  visitId         String
  taskType        String           // Changed from TaskType enum → String (supports custom task types)
  title           String
  description     String?
  status          TaskStatus       @default(PENDING)
  orderIndex      Int
  mdMeetingAnswer MdMeetingAnswer?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  visit    Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  subtasks Subtask[]

  @@unique([visitId, taskType])
  @@map("tasks")
}

model Subtask {
  id                 String    @id @default(cuid())
  taskId             String
  title              String
  isCompleted        Boolean   @default(false)
  incompletionReason String?
  isCarriedForward   Boolean   @default(false)
  sourceSubtaskId    String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ─── Admin-controlled carry-forward ───────────────────────────────────────
  // The application no longer creates carry-forward on its own. An incomplete
  // subtask on a finished visit becomes a PENDING carry-forward *request*
  // (carryForwardRequestedAt). Nothing is copied into a future visit until an
  // admin approves it, at which point carryForwardApprovedAt/By are stamped
  // and the carried copy is created. Rejecting stamps carryForwardRejectedAt.
  carryForwardRequestedAt DateTime?
  carryForwardApprovedAt  DateTime?
  carryForwardApprovedById String?
  carryForwardRejectedAt  DateTime?

  task              Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sourceSubtask     Subtask?  @relation("CarryForward", fields: [sourceSubtaskId], references: [id])
  carriedSubtasks   Subtask[] @relation("CarryForward")
  carryForwardApprovedBy User? @relation("CarryForwardApprovals", fields: [carryForwardApprovedById], references: [id])

  // A given source subtask can be carried into a given task at most once -
  // DB-level guard against concurrent carry-forward sweeps racing past the
  // in-memory idempotency check (serverless: one throttle per process).
  // NULL sourceSubtaskId (normal subtasks) is unaffected - Postgres treats
  // NULLs as distinct in unique indexes.
  @@unique([taskId, sourceSubtaskId])
  // Carry-forward screens filter on these two columns across the whole
  // subtask table (the largest table in the schema).
  @@index([isCarriedForward])
  @@index([carryForwardRequestedAt])
  // Clearing carry-forward provenance when a visit is deleted looks rows up
  // by this pointer; without an index that is a full scan of every subtask.
  @@index([sourceSubtaskId])
  @@map("subtasks")
}

model SubtaskTemplate {
  id         String   @id @default(cuid())
  taskType   String   // Changed from TaskType enum → String (supports custom task types)
  title      String
  orderIndex Int
  isActive   Boolean  @default(true)
  clientId   String?  // null = global default template; set = client-specific override
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client     Client?  @relation("ClientSubtaskTemplates", fields: [clientId], references: [id], onDelete: Cascade)

  // Resolving a client's task plan reads templates by client (and by task
  // type within it) every time a visit is created.
  @@index([clientId, taskType])
  @@map("subtask_templates")
}

model VisitReassignment {
  id              String   @id @default(cuid())
  visitId         String
  fromExecutiveId String
  toExecutiveId   String
  reason          String
  reassignedById  String
  createdAt       DateTime @default(now())

  visit         Visit @relation(fields: [visitId], references: [id])
  fromExecutive User  @relation("ReassignFrom", fields: [fromExecutiveId], references: [id])
  toExecutive   User  @relation("ReassignTo", fields: [toExecutiveId], references: [id])
  reassignedBy  User  @relation("ReassignedBy", fields: [reassignedById], references: [id])

  @@index([visitId])
  @@map("visit_reassignments")
}

model ActivityLog {
  id        String         @id @default(cuid())
  visitId   String?
  userId    String
  action    ActivityAction
  metadata  Json?
  createdAt DateTime       @default(now())

  visit Visit? @relation(fields: [visitId], references: [id])
  user  User   @relation(fields: [userId], references: [id])

  // The activity table grows fastest of all and had no index at all:
  //   visitId            a visit's own history, and its cleanup on delete
  //   (userId, createdAt) an executive's recent activity feed
  //   (action, createdAt) the carry-forward activity list
  @@index([visitId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("activity_logs")
}

// ─── Visit Delegation ─────────────────────────────────────────────────────────
// Created when an executive wants leave but has a scheduled visit.
// The target executive can ACCEPT (visit transfers + leave proceeds) or
// REJECT (original exec is notified and can retry).
model VisitDelegation {
  id               String           @id @default(cuid())
  visitId          String
  fromExecutiveId  String           // the exec requesting leave
  toExecutiveId    String           // the exec being asked to cover
  status           DelegationStatus @default(PENDING)
  rejectionReason  String?          // set by toExecutive on rejection
  leaveDate        DateTime         // the date leave is requested for
  leaveReason      String           // stored so leave can be auto-submitted on accept
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  visit         Visit @relation(fields: [visitId], references: [id])
  fromExecutive User  @relation("DelegationFrom", fields: [fromExecutiveId], references: [id])
  toExecutive   User  @relation("DelegationTo",   fields: [toExecutiveId],   references: [id])

  @@index([visitId])
  // "Delegations waiting for me" — the executive's incoming-requests poll.
  @@index([toExecutiveId, status])
  @@map("visit_delegations")
}
